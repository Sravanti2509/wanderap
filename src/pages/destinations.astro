---
import Layout from "../layouts/Layout.astro";
import { sanityClient } from "../lib/sanity";
import { urlFor } from "../lib/sanityImage";

const destinations = await sanityClient.fetch(`
  *[_type == "place"] | order(_createdAt asc) {
    _id,
    title,
    description,
    region,
    price,
    photo,
    "slug": slug.current
  }
`);
---

<Layout title="Destinations | WANDERAP">

  <main class="destinations">

    <!-- HEADER -->

    <div class="section-header">

      <div>

        <p class="section-label">
          DESTINATIONS
        </p>

        <h1>
          Places to explore
        </h1>

      </div>

      <span class="destination-count">
        {destinations.length} places
      </span>

    </div>


    <!-- DESTINATION GRID -->

    <div class="destination-grid">

      {destinations.map((destination) => (

        <article class="destination-card">

          <!-- IMAGE -->

          <a
            href={`/destinations/${destination.slug}`}
            class="image-link"
          >

            <div class="image-container">

              {destination.photo ? (

                <img
                  src={urlFor(destination.photo)
                    .width(900)
                    .height(650)
                    .quality(90)
                    .url()}
                  alt={destination.title}
                />

              ) : (

                <div class="no-image">
                  WANDERAP
                </div>

              )}

            </div>

          </a>


          <!-- CONTENT -->

          <div class="card-content">

            <p class="region">
              {destination.region}
            </p>

            <h2>
              {destination.title}
            </h2>

            <p class="description">
              {destination.description}
            </p>


            <div class="card-bottom">

              <span class="price">
                From ₹{destination.price}
              </span>

              <a
                href={`/destinations/${destination.slug}`}
                class="explore"
              >
                Explore
                <span>→</span>
              </a>

            </div>

          </div>

        </article>

      ))}

    </div>

  </main>

</Layout>


<style>

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
}

:global(body) {

  margin: 0;

  background: #eeeae1;

  color: #202321;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

}

:global(a) {

  color: inherit;

  text-decoration: none;

}


/* =========================
   DESTINATIONS
========================= */

.destinations {

  min-height: 100vh;

  padding:
    75px 7%
    100px;

  background: #eeeae1;

}


/* =========================
   HEADER
========================= */

.section-header {

  display: flex;

  align-items: end;

  justify-content: space-between;

  gap: 30px;

  margin-bottom: 38px;

}

.section-label {

  margin:
    0 0 10px;

  color: #77736b;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 3px;

}

.section-header h1 {

  margin: 0;

  color: #202321;

  font-size:
    clamp(
      38px,
      5vw,
      55px
    );

  font-weight: 600;

  line-height: 1;

  letter-spacing: -2px;

}

.destination-count {

  color: #77736b;

  font-size: 12px;

}


/* =========================
   GRID
========================= */

.destination-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 24px;

}


/* =========================
   CARD
========================= */

.destination-card {

  overflow: hidden;

  background: #ffffff;

  border:
    1px solid #ddd8ce;

  border-radius: 3px;

  transition:
    transform .25s ease,
    box-shadow .25s ease;

}

.destination-card:hover {

  transform:
    translateY(-4px);

  box-shadow:
    0 14px 32px
    rgba(48, 43, 35, .10);

}


/* =========================
   IMAGE
========================= */

.image-container {

  width: 100%;

  height: 250px;

  overflow: hidden;

  background: #d8d3c9;

}

.image-container img {

  display: block;

  width: 100%;

  height: 100%;

  object-fit: cover;

  transition:
    transform .55s ease;

}

.destination-card:hover
.image-container img {

  transform:
    scale(1.045);

}

.no-image {

  width: 100%;

  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #d8d3c9;

  color: #77736b;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 3px;

}


/* =========================
   CONTENT
========================= */

.card-content {

  padding:
    22px 23px 23px;

}

.region {

  margin:
    0 0 9px;

  color: #8a867e;

  font-size: 10px;

  font-weight: 600;

  text-transform: uppercase;

  letter-spacing: 1.5px;

}

.card-content h2 {

  margin: 0;

  color: #202321;

  font-size: 24px;

  font-weight: 600;

  line-height: 1.2;

  letter-spacing: -.4px;

}

.description {

  min-height: 43px;

  margin:
    12px 0 20px;

  color: #74736e;

  font-size: 13px;

  line-height: 1.65;

}


/* =========================
   BOTTOM
========================= */

.card-bottom {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding-top: 15px;

  border-top:
    1px solid #eeeae3;

}

.price {

  color: #44443f;

  font-size: 13px;

  font-weight: 600;

}

.explore {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  color: #202321;

  font-size: 12px;

  font-weight: 700;

}

.explore span {

  font-size: 16px;

  transition:
    transform .2s ease;

}

.explore:hover span {

  transform:
    translateX(4px);

}


/* =========================
   TABLET
========================= */

@media (max-width: 950px) {

  .destination-grid {

    grid-template-columns:
      repeat(2, 1fr);

  }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 650px) {

  .destinations {

    padding:
      55px 6%
      75px;

  }

  .section-header {

    align-items: flex-start;

    flex-direction: column;

    gap: 10px;

    margin-bottom: 28px;

  }

  .section-header h1 {

    font-size: 40px;

    letter-spacing: -1.5px;

  }

  .destination-grid {

    grid-template-columns: 1fr;

    gap: 20px;

  }

  .image-container {

    height: 230px;

  }

  .card-content h2 {

    font-size: 22px;

  }

  .description {

    min-height: auto;

  }

}

</style>