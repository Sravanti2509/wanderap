---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Experiences | WANDERAP">

  <main>

    <!-- PAGE HEADER -->

    <section class="header-section">

      <p>EXPERIENCES</p>

      <h1>
        Things to explore
      </h1>

      <span>
        Discover memorable experiences across Andhra Pradesh.
      </span>

    </section>


    <!-- EXPERIENCES -->

    <section class="experiences">

      <div class="experience-grid">


        <div class="experience-card">

          <img
            src="https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1000&q=80"
            alt="Coffee Plantations"
          />

          <div class="content">

            <small>01</small>

            <h2>Coffee Plantations</h2>

            <p>
              Explore the beautiful coffee plantations
              and peaceful hills of Araku Valley.
            </p>

            <a href="/destinations">
              Explore Araku →
            </a>

          </div>

        </div>


        <div class="experience-card">

          <img
            src="https://images.unsplash.com/photo-1433086966358-54859d0ed716?auto=format&fit=crop&w=1000&q=80"
            alt="Waterfalls"
          />

          <div class="content">

            <small>02</small>

            <h2>Waterfalls</h2>

            <p>
              Discover beautiful waterfalls surrounded
              by green forests and hills.
            </p>

            <a href="/destinations">
              Discover places →
            </a>

          </div>

        </div>


        <div class="experience-card">

          <img
            src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1000&q=80"
            alt="Beach"
          />

          <div class="content">

            <small>03</small>

            <h2>Beach Escapes</h2>

            <p>
              Relax by the sea and enjoy beautiful
              sunsets along the Vizag coastline.
            </p>

            <a href="/destinations">
              Explore Vizag →
            </a>

          </div>

        </div>


        <div class="experience-card">

          <img
            src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1000&q=80"
            alt="Andhra Food"
          />

          <div class="content">

            <small>04</small>

            <h2>Local Food</h2>

            <p>
              Taste authentic Andhra flavours and
              discover local food and traditions.
            </p>

            <a href="/destinations">
              Explore Andhra →
            </a>

          </div>

        </div>


      </div>

    </section>


  </main>

</Layout>


<style>

:global(*) {
  box-sizing: border-box;
}

:global(body) {
  margin: 0;
  background: #f7f5f0;
  color: #222;
  font-family: Arial, Helvetica, sans-serif;
}

:global(a) {
  color: inherit;
  text-decoration: none;
}


/* HEADER */

.header-section {
  padding: 120px 7% 45px;
}

.header-section p {
  margin: 0 0 10px;

  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  color: #777;
}

.header-section h1 {
  margin: 0 0 12px;

  font-size: 55px;
  font-weight: 600;
  letter-spacing: -2px;
}

.header-section span {
  color: #666;
  font-size: 15px;
}


/* EXPERIENCES */

.experiences {
  padding: 0 7% 70px;
}

.experience-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
}


/* CARD */

.experience-card {
  background: white;
  border: 1px solid #e4e1db;
}

.experience-card img {
  display: block;

  width: 100%;
  height: 270px;

  object-fit: cover;
}

.content {
  padding: 22px;
}

.content small {
  color: #999;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.content h2 {
  margin: 8px 0 10px;

  font-size: 27px;
  font-weight: 600;
}

.content p {
  margin: 0 0 18px;

  color: #666;

  font-size: 14px;
  line-height: 1.6;
}

.content a {
  font-size: 13px;
  font-weight: 700;
}

.content a:hover {
  opacity: .6;
}


/* MOBILE */

@media (max-width: 750px) {

  .header-section {
    padding: 105px 6% 35px;
  }

  .header-section h1 {
    font-size: 43px;
  }

  .experiences {
    padding: 0 6% 50px;
  }

  .experience-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .experience-card img {
    height: 240px;
  }

}

</style>